<Application x:Class="LicenseTracker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LicenseTracker">
    <Application.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MercuryUI;component/MercuryUI.xaml"/>

                <ResourceDictionary Source="Resources/Dictionaries/Borders.xaml"/>
                <ResourceDictionary Source="Resources/Dictionaries/Buttons.xaml"/>
                <ResourceDictionary Source="Resources/Dictionaries/Converters.xaml"/>
                <ResourceDictionary Source="Resources/Dictionaries/Images.xaml"/>
                <ResourceDictionary Source="Resources/Dictionaries/TextControls.xaml"/>
                <ResourceDictionary Source="Resources/Dictionaries/Variables.xaml"/>
                <ResourceDictionary Source="Resources/Dictionaries/Windows.xaml"/>

                <!-- Relies on TextControls.xaml for interal styles -->
                <ResourceDictionary Source="Resources/Dictionaries/PanelControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
         
    </Application.Resources>
</Application>
