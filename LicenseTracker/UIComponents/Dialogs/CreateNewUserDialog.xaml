<Window x:Class="LicenseTracker.UIComponents.Dialogs.CreateNewUserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LicenseTracker.UIComponents.Dialogs"
        mc:Ignorable="d"
        Title="New user"
        Style="{StaticResource AddItemDialogWindowStyle}"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=NameTextBox}">
    
    <Grid>
        <Border Style="{StaticResource DialogOutterBorderStyle}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- #Title Bar -->
                <Border
                    Grid.Row="0"
                    Style="{StaticResource DialogWindowSectionBorderStyle}"
                    Margin="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                            <Label Content="New User" Foreground="{StaticResource WindowTitleBarForeground}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Click="XButton_Click">
                                <Button.Resources>
                                    <Style TargetType="Button" BasedOn="{StaticResource WindowTitleBarTransparentIconButtonStyle}">
                                        <Style.Triggers>
                                            <!-- #Mouse over behaviors -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource TransparentIconButtonAlertMouseOver}"/>
                                            </Trigger>
                                            <!-- #Pressed behaviors -->
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="{StaticResource TransparentIconButtonAlertPressed}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Resources>
                                <Image>
                                    <Image.Resources>
                                        <Style TargetType="Image" BasedOn="{StaticResource TransparentIconButtonImageStyle}">
                                            <Setter Property="Source" Value="{StaticResource XLightGray}"/>
                                            <Style.Triggers>
                                                <!-- #Mouse over beahaviors -->
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsMouseOver}" Value="True">
                                                    <Setter Property="Source" Value="{StaticResource XWhite}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Resources>
                                </Image>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- #Content -->
                <Border Grid.Row="1" Style="{StaticResource DialogWindowSectionBorderStyle}">
                    <ScrollViewer Style="{StaticResource InputFieldDialogScrollViewerStyle}">
                        <!-- #Name -->
                        <Grid Style="{StaticResource InputFieldDialogGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Label
                                Grid.Column="0"
                                Content="Name:"/>
                            <TextBox
                                Grid.Column="1"
                                x:Name="NameTextBox"
                                Text="{Binding NameText}"/>
                        </Grid>
                    </ScrollViewer>
                </Border>
                
                <!-- #Controls -->
                <Border Grid.Row="2" Style="{StaticResource DialogWindowSectionBorderStyle}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <StackPanel.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource InputFieldDialogButtonStyle}"/>
                        </StackPanel.Resources>
                        <Button Content="Add" Click="AddButton_Click"/>
                        <Button Content="Cancel" Click="CancelButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
            
        </Border>
    </Grid>
    
</Window>
