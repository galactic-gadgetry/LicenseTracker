<Window x:Class="LicenseTracker.UIComponents.Dialogs.CreateNewLicenseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LicenseTracker.UIComponents.Dialogs"
        mc:Ignorable="d"
        Title="New License"
        Style="{StaticResource DialogWindowStyle}"
        WindowStartupLocation="CenterOwner">
    
    <Grid>
        <Border Style="{StaticResource DialogOutterBorderStyle}">

            <Grid>
                <Grid.Resources>
                    <Style x:Key="WindowSectionBorderStyle" TargetType="Border">
                        <Setter Property="Margin" Value="2,5,5,10"/>
                    </Style>
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- #Title Bar -->
                <Border
                    Grid.Row="0"
                    Style="{StaticResource WindowSectionBorderStyle}"
                    Margin="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                            <Label Content="New License" Foreground="{StaticResource WindowTitleBarForeground}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Click="XButton_Click">
                                <Button.Resources>
                                    <Style TargetType="Button" BasedOn="{StaticResource WindowTitleBarTransparentIconButtonStyle}">
                                        <Style.Triggers>
                                            <!-- #Mouse over behaviors -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource TransparentIconButtonAlertMouseOver}"/>
                                            </Trigger>
                                            <!-- #Pressed behaviors -->
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="{StaticResource TransparentIconButtonAlertPressed}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Resources>
                                <Image>
                                    <Image.Resources>
                                        <Style TargetType="Image" BasedOn="{StaticResource TransparentIconButtonImageStyle}">
                                            <Setter Property="Source" Value="{StaticResource XLightGray}"/>
                                            <Style.Triggers>
                                                <!-- #Mouse over beahaviors -->
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsMouseOver}" Value="True">
                                                    <Setter Property="Source" Value="{StaticResource XWhite}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Resources>
                                </Image>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- #Content -->
                <Border Grid.Row="1" Style="{StaticResource WindowSectionBorderStyle}">
                    <ScrollViewer Padding="0,0,10,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel.Resources>
                                <Style x:Key="SubtitleBorderStyle" TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{StaticResource LayerBorderBrush1}"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                </Style>

                                <Style x:Key="SubtitleLabelStyle" TargetType="Label" BasedOn="{StaticResource DefaultLabelStyle}">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </StackPanel.Resources>
                            <!-- #Product -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- #Subtitle -->
                                <Border Grid.Row="0" Style="{StaticResource SubtitleBorderStyle}">
                                    <Label Content="Product" Style="{StaticResource SubtitleLabelStyle}"/>
                                </Border>

                                <Grid Grid.Row="1" Style="{StaticResource InputFieldDialogGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- #Product -->
                                    <Label
                                        Grid.Column="0" Grid.Row="0"
                                        Content="Product:"/>
                                    <ComboBox
                                        Grid.Column="1" Grid.Row="0"
                                        SelectedIndex="0">
                                        <ComboBoxItem>Product 1</ComboBoxItem>
                                    </ComboBox>
                                    <Button
                                        Grid.Column="2" Grid.Row="0"
                                        Content="Add"/>

                                    <!-- #Number/ID-->
                                    <Label
                                        Grid.Column="0" Grid.Row="1"
                                        Content="Number/ID:"/>
                                    <TextBox
                                        Grid.Column="1" Grid.Row="1"
                                        Text="1234567890"/>

                                    <!-- #Issue Date -->
                                    <Label
                                        Grid.Column="0" Grid.Row="2"
                                        Content="Issue Date:"/>
                                    <DatePicker Grid.Column="1" Grid.Row="2"/>

                                    <!-- #Expiration Date -->
                                    <Label
                                        Grid.Column="0" Grid.Row="3"
                                        Content="Expiration Date:"/>
                                    <DatePicker Grid.Column="1" Grid.Row="3"/>

                                    <!-- #Status -->
                                    <Label
                                        Grid.Column="0" Grid.Row="4"
                                        Content="Status"/>
                                    <ComboBox
                                        Grid.Column="1" Grid.Row="4"
                                        SelectedIndex="0">
                                        <ComboBoxItem>Active</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                            </Grid>
                            
                            <!-- #User -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- #Subtitle -->
                                <Border Grid.Row="0" Style="{StaticResource SubtitleBorderStyle}">
                                    <Label Content="Users" Style="{StaticResource SubtitleLabelStyle}"/>
                                </Border>
                                
                                <!-- #User -->
                                <Grid Grid.Row="1" Style="{StaticResource InputFieldDialogGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition  Height="Auto"/>
                                        <RowDefinition  Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <Label
                                        Grid.Column="0" Grid.Row="0"
                                        Content="User:"/>
                                    <ComboBox
                                        Grid.Column="1" Grid.Row="0"
                                        SelectedIndex="0">
                                        <ComboBoxItem>User 1</ComboBoxItem>
                                    </ComboBox>
                                    <Button
                                        Grid.Column="2" Grid.Row="0"
                                        Content="Add"/>

                                    <!-- #Administrator -->
                                    <Label
                                        Grid.Column="0" Grid.Row="1"
                                        Content="Administrator:"/>
                                    <ComboBox
                                        Grid.Column="1" Grid.Row="1"
                                        SelectedIndex="0">
                                        <ComboBoxItem>User 1</ComboBoxItem>
                                    </ComboBox>
                                    <Button
                                        Grid.Column="2" Grid.Row="1"
                                        Content="Add"/>
                                </Grid>
                            </Grid>
                            
                            <!-- #Vendor -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- #Subtitle -->
                                <Border Grid.Row="0" Style="{StaticResource SubtitleBorderStyle}">
                                    <Label Content="Vendor" Style="{StaticResource SubtitleLabelStyle}"/>
                                </Border>
                                
                                <!-- #Vendor -->
                                <Grid Grid.Row="1" Style="{StaticResource InputFieldDialogGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <Label
                                        Grid.Column="0" Grid.Row="0"
                                        Content="Vendor"/>
                                    <ComboBox
                                        Grid.Column="1" Grid.Row="0"
                                        SelectedIndex="0">
                                        <ComboBoxItem>Vendor 1</ComboBoxItem>
                                    </ComboBox>
                                    <Button
                                        Grid.Column="2" Grid.Row="0"
                                        Content="Add"/>

                                    <!-- #Purchase Date -->
                                    <Label
                                        Grid.Column="0" Grid.Row="1"
                                        Content="Purchase Date:"/>
                                    <DatePicker Grid.Column="1" Grid.Row="1"/>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                
                <!-- #Controls -->
                <Border Grid.Row="2" Style="{StaticResource WindowSectionBorderStyle}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <StackPanel.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource InputFieldDialogButtonStyle}"/>
                        </StackPanel.Resources>
                        <Button Content="Create"/>
                        <Button Content="Cancel"/>
                    </StackPanel>
                </Border>
            </Grid>
            
        </Border>
    </Grid>
    
</Window>
