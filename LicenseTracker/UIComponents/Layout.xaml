<UserControl x:Class="LicenseTracker.UIComponents.Layout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LicenseTracker.UIComponents"
             xmlns:view="clr-namespace:LicenseTracker.Views"
             xmlns:vm="clr-namespace:LicenseTracker.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="1500">
    
    <Grid>
        <Border Background="{StaticResource ViewBackground}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- #Main Content -->
                <Border Grid.Row="0">
                    <ContentControl Content="{Binding CurrentContentViewModel}">
                        <ContentControl.Resources>
                            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                                <view:DashboardView/>
                            </DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>
                </Border>
                
                
                <!-- #Info Bar -->
                <Border Grid.Row="1">
                    <Label Content="Info Bar placeholder" FontSize="9"/>
                </Border>
            </Grid>

        </Border>
    </Grid>
    
</UserControl>
