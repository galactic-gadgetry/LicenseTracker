<UserControl x:Class="LicenseTracker.UIComponents.Cards.NotificationCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LicenseTracker.UIComponents.Cards"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="1480">

    <Grid>
        <Border
            Background="{StaticResource AccentLayerFillColorBrush1}"
            Padding="10"
            CornerRadius="4">
            
            <StackPanel>
                <StackPanel.Resources>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultTextBlockStyle}">
                        <Setter Property="Foreground" Value="White"/>
                    </Style>
                </StackPanel.Resources>
                <TextBlock
                    Text="Notification Title"
                    FontWeight="Bold"/>
                <TextBlock
                    Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Cras nec ultrices dolor, vitae sagittis nunc. Cras ac maximus lectus. Nullam eget erat neque. Ut euismod vehicula nisl eu auctor. Morbi massa tortor, convallis non leo eu, cursus porta ipsum. Aenean scelerisque, nisl sit amet rhoncus vestibulum, erat risus ultrices sem, sed tincidunt mi ante vel arcu. Nullam at sodales dolor. Curabitur non arcu egestas, vulputate turpis et, finibus mauris. Curabitur eu neque eu turpis tincidunt rutrum. Praesent rutrum turpis elit, eget finibus mi vestibulum a."
                    TextWrapping="Wrap"/>
            </StackPanel>
            
        </Border>
    </Grid>
    
</UserControl>
