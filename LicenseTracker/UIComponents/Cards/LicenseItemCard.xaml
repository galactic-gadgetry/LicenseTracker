<UserControl x:Class="LicenseTracker.UIComponents.Cards.LicenseItemCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LicenseTracker.UIComponents.Cards"
             mc:Ignorable="d"
             d:Background="White"
             Height="150" Width="1000">
    
    <Grid>
        <Border>

            <Grid>
                <Expander>
                    <Expander.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- #Top Row -->
                            <Border Grid.Row="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0">
                                        <Ellipse
                                            Fill="Pink"
                                            Height="25" Width="25"/>
                                    </Border>

                                    <Border Grid.Column="1">
                                        <Label Content="Software1"/>
                                    </Border>

                                    <Border Grid.Column="2">
                                        <Label Content="1234567890"/>
                                    </Border>
                                </Grid>
                            </Border>
                            
                            <!-- #Bottom Row -->
                            <Border Grid.Row="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0">
                                        <Label Content="User name 1"/>
                                    </Border>

                                    <Border Grid.Column="1">
                                        <Label Content="12/31/2999"/>
                                    </Border>

                                    <Border Grid.Column="2">
                                        <Label Content="Status 1"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Expander.Header>
                </Expander>
            </Grid>
            
        </Border>
    </Grid>
    
</UserControl>
