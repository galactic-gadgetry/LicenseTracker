<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <Style x:Key="InputFieldDialogGridStyle" TargetType="Grid">
        <Style.Resources>
            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="65"/>
                <Setter Property="Margin" Value="10,0,0,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                <Setter Property="MinWidth" Value="100"/>
                <Setter Property="MaxWidth" Value="200"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style TargetType="DatePicker" BasedOn="{StaticResource DefaultDatePickerStyle}">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Style.Resources>
                    <!-- This prevents the preceding button style from overriding the
                    date picker's default button style. -->
                    <Style TargetType="Button"/>
                </Style.Resources>
            </Style>

            <Style TargetType="Label" BasedOn="{StaticResource DefaultLabelStyle}">
                <Setter Property="Margin" Value="0,5,10,5"/>
            </Style>

            <Style TargetType="TextBox" BasedOn="{StaticResource InputFieldTextBoxStyle}">
                <Setter Property="MinWidth" Value="200"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Style.Resources>
    </Style>

    <Style x:Key="InputFieldDialogScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="Padding" Value="0,0,10,0"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    </Style>
    
</ResourceDictionary>