<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <Style x:Key="DialogWindowStyle" TargetType="Window" BasedOn="{StaticResource DefaultWindowStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Height" Value="650"/>
        <Setter Property="Width" Value="550"/>
        <Setter Property="MinHeight" Value="193"/>
        <Setter Property="MinWidth" Value="287"/>
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="AllowsTransparency" Value="True"/>
        <Setter Property="SizeToContent" Value="WidthAndHeight"/>
        <Setter Property="ResizeMode" Value="CanResizeWithGrip"/>
    </Style>

    <Style x:Key="AddItemDialogWindowStyle" TargetType="Window" BasedOn="{StaticResource DialogWindowStyle}">
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
    </Style>
    
</ResourceDictionary>